# VOX API configuration (all variables optional; defaults shown)

# Bind address
VOX_HOST=0.0.0.0
VOX_PORT=8080

# Logging: RUST_LOG controls level/filter, VOX_LOG_FORMAT selects encoding.
RUST_LOG=info
VOX_LOG_FORMAT=text

# Retrieval backend: `mock` (deterministic, in-process) or `http` (OREO
# service). When mode=http, VOX_RETRIEVAL_BASE_URL is required. Retries are
# safe-only: network errors, timeouts, 5xx, and 429 — exactly one by default.
VOX_RETRIEVAL_MODE=mock
# VOX_RETRIEVAL_BASE_URL=http://oreo-retrieval:8080
VOX_RETRIEVAL_TIMEOUT_MS=800
VOX_RETRIEVAL_MAX_RETRIES=1
VOX_RETRIEVAL_BACKOFF_MS=50
VOX_MOCK_DELAY_MS=0

# Speech-to-text backend: `mock` (deterministic, in-process) or `sarvam`
# (Sarvam AI speech-to-text). When mode=sarvam, VOX_SARVAM_API_KEY is required.
VOX_STT_MODE=mock
# VOX_SARVAM_API_KEY=your-subscription-key
# VOX_SARVAM_MODEL=saarika:v2.5
# VOX_SARVAM_BASE_URL=https://api.sarvam.ai
# VOX_SARVAM_TIMEOUT_MS=3000

# Answer generation: `extractive` (deterministic baseline, no network) or
# `openai` (any OpenAI-compatible /chat/completions endpoint). When mode=openai,
# VOX_LLM_API_KEY is required. Never commit real keys.
VOX_LLM_MODE=extractive
# VOX_LLM_API_KEY=sk-your-key
# VOX_LLM_MODEL=gpt-4o-mini
# VOX_LLM_BASE_URL=https://api.openai.com/v1
# VOX_LLM_TIMEOUT_MS=8000

# Grounding thresholds: evidence-sufficiency scoring maps relevance (best
# single-document query-term coverage), coverage (union coverage), and
# consistency (agreement among relevant documents) onto answerability:
# supported / weak_evidence / no_evidence / conflicting_evidence.
VOX_GROUNDING_MIN_SCORE=0.30
VOX_GROUNDING_RELEVANCE_MIN=0.50
VOX_GROUNDING_COVERAGE_MIN=0.50
VOX_GROUNDING_CONSISTENCY_MIN=0.50
VOX_GROUNDING_AGREEMENT_MIN=0.10

# Output guardrail: share of a generated answer's content tokens that must
# appear in the evidence; invented numbers always refuse/regenerate.
VOX_GUARD_ANSWER_SUPPORT_MIN=0.60
