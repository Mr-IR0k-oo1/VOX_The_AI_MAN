# VOX API configuration (all variables optional; defaults shown)

# Bind address
VOX_HOST=0.0.0.0
VOX_PORT=8080

# Logging: RUST_LOG controls level/filter, VOX_LOG_FORMAT selects encoding.
RUST_LOG=info
VOX_LOG_FORMAT=text

# Retrieval backend: `mock` (deterministic, in-process), `oreo` (embedded
# OREO engine), or `http` (standalone OREO service). When mode=http,
# VOX_RETRIEVAL_BASE_URL is required.
VOX_RETRIEVAL_MODE=mock
# VOX_RETRIEVAL_BASE_URL=http://oreo-retrieval:8080
VOX_RETRIEVAL_TIMEOUT_MS=800
VOX_RETRIEVAL_MAX_RETRIES=2
VOX_RETRIEVAL_BACKOFF_MS=50
VOX_MOCK_DELAY_MS=0

# OREO retrieval engine (used when VOX_RETRIEVAL_MODE=oreo, and by the
# standalone `vox-oreo` binary; all optional, defaults shown)
VOX_OREO_LANGUAGES=en,hi,ta
VOX_OREO_CHUNKING=sentence:700:80
# VOX_OREO_EMBEDDING_DIM=256
VOX_OREO_VECTOR_STORE=memory
# VOX_OREO_QDRANT_URL=http://localhost:6333
# VOX_OREO_COLLECTION=vox-chunks
VOX_OREO_TANTIVY_DIR=data/oreo-index
VOX_OREO_CANDIDATE_TOP=20
VOX_OREO_FINAL_TOP=5
VOX_OREO_RRF_K=60
VOX_OREO_RERANKER=lexical

# Grounding: refuse answers when the best evidence score is below this.
VOX_GROUNDING_MIN_SCORE=0.30

# Speech-to-text backend: `mock` (deterministic, in-process) or `sarvam`
# (Sarvam AI speech-to-text). When mode=sarvam, VOX_SARVAM_API_KEY is required.
VOX_STT_MODE=mock
# VOX_SARVAM_API_KEY=your-subscription-key
# VOX_SARVAM_MODEL=saarika:v2.5
# VOX_SARVAM_BASE_URL=https://api.sarvam.ai
# VOX_SARVAM_TIMEOUT_MS=3000
